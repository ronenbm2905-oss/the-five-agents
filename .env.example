# ==============================================
# קובץ דוגמה למשתני סביבה — צוות הסוכנים
# העתק קובץ זה ל-.env ומלא את הערכים האמיתיים.
# אין להעלות את .env ל-git (הוא מכיל סודות).
# ==============================================

# --- Claude / Anthropic API ---
# מפתח ה-API של Anthropic (משמש את כל הסוכנים)
ANTHROPIC_API_KEY=

# מזהה המודל שבו משתמשים כברירת מחדל
ANTHROPIC_MODEL=claude-opus-4-8

# --- יובל (מעצב התמונות) ---
# מפתח API של OpenAI ליצירת תמונות (סקיל gpt-image-gen, מודל gpt-image-2)
OPENAI_API_KEY=

# --- חן (החוקרת) ---
# מפתח API לחיפוש / מחקר באינטרנט
SEARCH_API_KEY=

# --- כללי ---
# סביבת הריצה: development / production
ENV=development
